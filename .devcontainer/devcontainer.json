// Dev container for Laker Code Gym.
// Open this folder in VS Code with the "Dev Containers" extension, or in GitHub Codespaces.
{
  "name": "Laker Code Gym",

  // Microsoft's Python dev container image; published for both amd64 and arm64,
  // so it runs on Windows, Linux, Intel Macs and Apple Silicon Macs.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // Runs once, after the container is first created.
  "postCreateCommand": "pip install --user -r .devcontainer/requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        // Every problem has its own mymodule.py, so tests are run one problem
        // at a time with the "Test this problem" task instead of the Testing panel.
        "python.testing.pytestEnabled": false,
        "editor.formatOnSave": false
      }
    }
  },

  // Preview the site with: python -m http.server 8000
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Code Gym site", "onAutoForward": "notify" }
  }
}
